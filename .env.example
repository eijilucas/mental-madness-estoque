# Copie esse arquivo pra ".env" (que já está no .gitignore) e preencha com os
# valores reais. Nunca commitar o .env.
#
# Atenção ao nome das lojas: é contraintuitivo — "mental-madness-basic" é a
# loja do drop EXCLUSIVO, e "m3ntalmadness" é a loja do BÁSICO. Confirmado com
# o Vitor em 14/08.
#
# CLIENT_ID + SECRET são trocados por um access_token em tempo real (client
# credentials grant) — não existe mais token fixo pra copiar/colar aqui.
# Ver src/shopify/auth.js.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que o cron manda no header Authorization pra chamar /api/cron-sync
# (Vercel Cron ou GitHub Actions). Gerar qualquer string aleatória.
CRON_SECRET=

# Loja do básico
SHOPIFY_BASICO_SHOP=m3ntalmadness.myshopify.com
SHOPIFY_BASICO_CLIENT_ID=
SHOPIFY_BASICO_SECRET=
# Paliativo: nome de drop cadastrado por engano na loja básico, separado por
# vírgula. Vazio = não esconde nada.
SHOPIFY_BASICO_EXCLUDE_DROPS=

# Loja do drop exclusivo
SHOPIFY_EXCLUSIVO_SHOP=mental-madness-basic.myshopify.com
SHOPIFY_EXCLUSIVO_CLIENT_ID=
SHOPIFY_EXCLUSIVO_SECRET=
# Atualizar a cada drop novo — só produto com esse termo no título entra na
# lista de produção do exclusivo. Deixar em branco traz tudo (todos os drops).
SHOPIFY_EXCLUSIVO_CURRENT_DROP=
